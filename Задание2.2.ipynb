**##############################################################**

**# Классификация ирисов методом KNN на Julia**

**##############################################################**



**# --- Установка пакетов ---**

**using Pkg**

**for pkg in \["MLJ", "RDatasets", "DataFrames", "NearestNeighbors", "Plots", "StatsPlots"]**

    **if !haskey(Pkg.project().dependencies, pkg)**

        **Pkg.add(pkg)**

    **end**

**end**



**using MLJ**

**using RDatasets**

**using DataFrames**

**using NearestNeighbors**

**using Random**

**using Plots**

**using StatsPlots**



**# --- 1. Загрузка и подготовка Iris ---**

**iris = dataset("datasets", "iris")**

**println("Пример данных:")**

**first(iris, 5) |> println**



**X = select(iris, Not(:Species))   # признаки**

**y = iris.Species                  # целевая переменная**



**Random.seed!(123)**

**train, test = partition(eachindex(y), 0.7, shuffle=true)**

**Xtrain, Xtest = X\[train, :], X\[test, :]**

**ytrain, ytest = y\[train], y\[test]**



**# --- 2. Модель KNN ---**

**KNN = @load KNNClassifier pkg=NearestNeighbors**

**knn\_model = KNN(K=5)   # 5 ближайших соседей**

**mach = machine(knn\_model, Xtrain, ytrain)**



**fit!(mach)**



**ŷ = predict(mach, Xtest)**

**yhat = mode.(ŷ)**



**# --- 3. Оценка точности ---**

**accuracy = mean(yhat .== ytest)**

**println("Точность модели: ", round(accuracy\*100, digits=2), "%")**



**cm = MLJ.confusion\_matrix(ytest, yhat)**

**println("\\nМатрица ошибок:")**

**println(cm)**



**# --- 4. Визуализация ---**

**# Для наглядности возьмём только 2 признака: длина и ширина лепестка**

**x1, x2 = :PetalLength, :PetalWidth**



**@df iris scatter(:PetalLength, :PetalWidth,**

    **group=:Species, legend=:topleft,**

    **title="Классы ирисов по признакам (PetalLength vs PetalWidth)",**

    **xlabel="Длина лепестка",**

    **ylabel="Ширина лепестка",**

    **markersize=4)**



**savefig("iris\_knn.png")**

**println("\\nГрафик сохранён как iris\_knn.png")**



